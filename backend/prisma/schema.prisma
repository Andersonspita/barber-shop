generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CLIENT
  BARBER
  ADMIN
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model User {
  id                 String    @id @default(uuid())
  /// Cada conta pertence a uma barbearia: equipe e clientes de uma não
  /// enxergam nem acessam a outra. O mesmo e-mail pode existir em barbearias
  /// diferentes, como contas independentes.
  shopId             String
  name               String
  email              String
  passwordHash       String
  phoneNumber        String?
  birthDate          DateTime?
  role               Role      @default(CLIENT)
  isAdmin            Boolean   @default(false)
  isActive           Boolean   @default(true)
  photoUrl           String?
  bio                String?
  mustChangePassword Boolean   @default(false)
  commissionRate     Decimal?  @db.Decimal(5, 2)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  clientAppointments  Appointment[]        @relation("ClientAppointments")
  barberAppointments  Appointment[]        @relation("BarberAppointments")
  createdAppointments Appointment[]        @relation("AppointmentCreatedBy")
  barberBlocks        ScheduleBlock[]      @relation("BarberBlocks")
  workingHours        WorkingHours[]       @relation("BarberWorkingHours")
  barberServices      BarberService[]      @relation("BarberServices")
  resetTokens         PasswordResetToken[] @relation("UserResetTokens")
  waitlistEntries     WaitlistEntry[]      @relation("ClientWaitlist")
  waitlistedFor       WaitlistEntry[]      @relation("BarberWaitlist")
  shop                Shop                 @relation(fields: [shopId], references: [id])

  @@unique([shopId, email])
  @@index([shopId, role, isActive])
  @@index([birthDate])
}

model Service {
  id              String   @id @default(uuid())
  shopId          String
  name            String
  description     String?
  durationMinutes Int
  price           Decimal  @db.Decimal(10, 2)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  appointments    Appointment[]
  barberServices  BarberService[] @relation("ServiceBarbers")
  waitlistEntries WaitlistEntry[] @relation("ServiceWaitlist")
  shop            Shop            @relation(fields: [shopId], references: [id])

  @@index([shopId, isActive])
}

/// Vínculo N-N entre barbeiro e serviço. Um barbeiro sem nenhuma linha aqui
/// é tratado como apto a todos os serviços (compatibilidade com bases antigas).
model BarberService {
  id                      String   @id @default(uuid())
  barberId                String
  serviceId               String
  /// Sobrescreve o preço do serviço para este barbeiro, quando preenchido.
  priceOverride           Decimal? @db.Decimal(10, 2)
  /// Sobrescreve a duração do serviço para este barbeiro, quando preenchida.
  durationMinutesOverride Int?
  createdAt               DateTime @default(now())

  barber  User    @relation("BarberServices", fields: [barberId], references: [id], onDelete: Cascade)
  service Service @relation("ServiceBarbers", fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([barberId, serviceId])
  @@index([serviceId])
}

model Appointment {
  id           String            @id @default(uuid())
  /// Redundante com o barbeiro, mas é o filtro de toda consulta de agenda e
  /// financeiro da barbearia — sem ele cada relatório precisaria de um join.
  shopId       String
  clientId     String
  barberId     String
  serviceId    String
  startTime    DateTime
  endTime      DateTime
  status       AppointmentStatus @default(SCHEDULED)
  /// Valor cobrado no momento da reserva. Sem ele, mudar o preço de um serviço
  /// reescreveria o faturamento de todos os meses anteriores.
  priceCharged Decimal           @db.Decimal(10, 2)
  notes        String?
  /// Quem registrou o agendamento: o próprio cliente, ou o barbeiro no encaixe de balcão.
  createdById  String?
  cancelledAt  DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  client    User    @relation("ClientAppointments", fields: [clientId], references: [id])
  barber    User    @relation("BarberAppointments", fields: [barberId], references: [id])
  createdBy User?   @relation("AppointmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  service   Service @relation(fields: [serviceId], references: [id])
  review    Review? @relation("AppointmentReview")
  shop      Shop    @relation(fields: [shopId], references: [id])

  @@index([shopId, startTime])
  @@index([barberId, startTime, endTime])
  @@index([clientId, startTime])
  @@index([status, startTime])
}

model ScheduleBlock {
  id        String   @id @default(uuid())
  barberId  String
  startTime DateTime
  endTime   DateTime
  reason    String?
  createdAt DateTime @default(now())

  barber User @relation("BarberBlocks", fields: [barberId], references: [id], onDelete: Cascade)

  @@index([barberId, startTime, endTime])
}

/// Jornada de trabalho recorrente de um barbeiro, por dia da semana.
/// Os minutos são contados a partir da meia-noite no fuso da barbearia.
/// Vários intervalos no mesmo dia representam, por exemplo, a pausa do almoço.
model WorkingHours {
  id          String   @id @default(uuid())
  barberId    String
  /// 0 = domingo … 6 = sábado
  weekday     Int
  startMinute Int
  endMinute   Int
  createdAt   DateTime @default(now())

  barber User @relation("BarberWorkingHours", fields: [barberId], references: [id], onDelete: Cascade)

  @@unique([barberId, weekday, startMinute])
  @@index([barberId, weekday])
}

/// Feriados e fechamentos da barbearia inteira.
model Holiday {
  id          String   @id @default(uuid())
  shopId      String
  /// Data no fuso da barbearia, normalizada para meia-noite UTC.
  date        DateTime @db.Date
  description String
  createdAt   DateTime @default(now())

  shop Shop @relation(fields: [shopId], references: [id])

  @@unique([shopId, date])
}

/// Uma barbearia atendida pela plataforma, com a configuração dela. Equipe,
/// clientes, serviços, agenda e feriados carregam o `shopId`.
///
/// A linha que existia antes do multi-tenant (id = "default") vira a primeira
/// barbearia, com todos os dados antigos pendurados nela.
model Shop {
  id                        String  @id @default(uuid())
  /// Identificador na URL pública: /<slug>. Só minúsculas, dígitos e hífen.
  slug                      String  @unique
  /// Barbearia suspensa some da vitrine e não aceita login nem agendamento.
  isActive                  Boolean @default(true)
  name                      String  @default("Gerente Barber")
  timezone                  String  @default("America/Sao_Paulo")
  slotIntervalMinutes       Int     @default(30)
  /// Antecedência mínima entre agora e o início do horário reservável.
  minAdvanceMinutes         Int     @default(30)
  /// Até quantos dias no futuro o cliente pode marcar.
  maxAdvanceDays            Int     @default(60)
  /// Prazo mínimo, antes do horário, para o cliente cancelar sozinho.
  cancellationWindowMinutes Int     @default(120)
  addressLine               String?
  city                      String?
  mapsUrl                   String?
  phone                     String?
  whatsapp                  String?
  instagram                 String?
  about                     String?
  /// Instância da Evolution API com o número de WhatsApp desta barbearia.
  /// Vazia, as mensagens saem pela instância padrão da plataforma.
  whatsappInstance          String?

  // ------------------------------------------------------------ mensalidade
  /// Plano contratado. Vazio só em barbearia de cortesia antiga.
  planCode      String?
  /// Fim do teste grátis. A primeira fatura cobre o mês que começa aqui.
  trialEndsAt   DateTime?
  /// Cortesia: não gera fatura nem tem limite de profissionais. As barbearias
  /// que já existiam antes da mensalidade entram assim, para nada mudar sem
  /// uma decisão explícita de quem opera a plataforma.
  billingExempt Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  services        Service[]
  appointments    Appointment[]
  holidays        Holiday[]
  waitlistEntries WaitlistEntry[]
  plan            Plan?           @relation(fields: [planCode], references: [code])
  invoices        Invoice[]

  @@map("shops")
}

/// Plano de mensalidade, pelo número de profissionais ativos.
model Plan {
  /// Identificador estável (`solo`, `essencial`…), usado no código e na API.
  code             String   @id
  name             String
  /// Máximo de profissionais ativos. Vazio = sem limite (cobra por excedente).
  maxBarbers       Int?
  /// Profissionais já incluídos na mensalidade.
  includedBarbers  Int
  monthlyPrice     Decimal  @db.Decimal(10, 2)
  /// Valor por profissional acima de `includedBarbers`, nos planos sem limite.
  extraBarberPrice Decimal? @db.Decimal(10, 2)
  sortOrder        Int      @default(0)
  isActive         Boolean  @default(true)
  updatedAt        DateTime @updatedAt

  shops Shop[]

  @@map("plans")
}

enum InvoiceStatus {
  OPEN
  PAID
  CANCELED
}

/// Fatura mensal de uma barbearia. Plano, profissionais e valor ficam
/// congelados no momento em que a fatura é gerada: mudar o preço do plano
/// depois não reescreve cobranças passadas.
model Invoice {
  id                String        @id @default(uuid())
  shopId            String
  /// Primeiro dia do mês coberto (inclusive) e dia seguinte ao último.
  periodStart       DateTime
  periodEnd         DateTime
  /// Paga-se adiantado: vence no primeiro dia do período.
  dueDate           DateTime
  planCode          String
  planName          String
  barbers           Int
  amount            Decimal       @db.Decimal(10, 2)
  status            InvoiceStatus @default(OPEN)
  paidAt            DateTime?
  /// Observação de quem deu baixa: "Pix recebido em 05/10", por exemplo.
  note              String?
  /// Avisos de WhatsApp já enviados, para não repetir.
  overdueNotifiedAt DateTime?
  blockedNotifiedAt DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, periodStart])
  @@index([status, dueDate])
  @@map("invoices")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation("UserResetTokens", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Review {
  id            String   @id @default(uuid())
  appointmentId String   @unique
  rating        Int
  comment       String?
  createdAt     DateTime @default(now())

  appointment Appointment @relation("AppointmentReview", fields: [appointmentId], references: [id], onDelete: Cascade)
}

/// "Avise-me se vagar": interesse registrado por um cliente num dia lotado.
model WaitlistEntry {
  id         String    @id @default(uuid())
  shopId     String
  clientId   String
  serviceId  String
  barberId   String?
  /// Dia desejado, normalizado para meia-noite UTC.
  date       DateTime  @db.Date
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())

  client  User    @relation("ClientWaitlist", fields: [clientId], references: [id], onDelete: Cascade)
  service Service @relation("ServiceWaitlist", fields: [serviceId], references: [id], onDelete: Cascade)
  barber  User?   @relation("BarberWaitlist", fields: [barberId], references: [id], onDelete: Cascade)
  shop    Shop    @relation(fields: [shopId], references: [id])

  @@unique([clientId, serviceId, date])
  @@index([shopId, date, notifiedAt])
}
