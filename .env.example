# Usado pelo docker-compose.yml na raiz do projeto.
# Copie para ".env" e ajuste os valores antes de rodar "docker compose up -d --build".

POSTGRES_USER=barbershop
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_DB=barbershop_db

# Gere com: openssl rand -base64 48
JWT_SECRET=troque-por-um-valor-aleatorio-longo
JWT_EXPIRES_IN=7d

# Deixe vazio para o frontend chamar a API pelo mesmo domínio (via nginx).
# Só preencha se o backend estiver num domínio/porta diferente do frontend.
NEXT_PUBLIC_API_URL=

# Porta do host que vai receber o tráfego (o nginx interno escuta nela).
# Use uma porta livre se a 80/443 já estiverem ocupadas por outro serviço/painel na VPS.
HTTP_PORT=8080

# Endereço público do frontend. Entra nos links de recuperação de senha e
# define a origem aceita pelo CORS da API.
APP_URL=http://localhost:8080

# Origens extras autorizadas a chamar a API, separadas por vírgula.
# Deixe vazio quando frontend e backend estão atrás do mesmo nginx.
CORS_ORIGINS=

# --- WhatsApp (Evolution API) -------------------------------------------
# Sem estas três variáveis o sistema segue funcionando: as mensagens vão
# para o log do backend em vez de sair pelo WhatsApp.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=barbearia

# DDI aplicado a telefones cadastrados sem código de país.
WHATSAPP_COUNTRY_CODE=55

# Quantas horas antes do horário o lembrete é enviado.
REMINDER_HOURS_BEFORE=2

# Hora do dia (no fuso da barbearia) em que saem as mensagens de aniversário.
BIRTHDAY_GREETING_HOUR=9
