# Usado pelo docker-compose.yml na raiz do projeto.
# Copie para ".env" e ajuste os valores antes de rodar "docker compose up -d --build".

POSTGRES_USER=barbershop
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_DB=barbershop_db

# Gere com: openssl rand -base64 48
JWT_SECRET=troque-por-um-valor-aleatorio-longo

# Deixe vazio para o frontend chamar a API pelo mesmo domínio (via nginx).
# Só preencha se o backend estiver num domínio/porta diferente do frontend.
NEXT_PUBLIC_API_URL=

# Porta do host que vai receber o tráfego (o nginx interno escuta nela).
# Use uma porta livre se a 80/443 já estiverem ocupadas por outro serviço/painel na VPS.
HTTP_PORT=8080
